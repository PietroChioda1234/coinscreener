{
  "manifest_version": 3,
  "name": "Coin Screener",
  "version": "0.7.0",
  "description": "AI meme quality scanner — sidebar on GMGN and DexScreener",
  "permissions": ["storage"],
  "host_permissions": [
    "https://gmgn.ai/*",
    "https://dexscreener.com/*",
    "https://api.dexscreener.com/*",
    "https://rugcheck.xyz/*",
    "https://api.rugcheck.xyz/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.anthropic.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://gmgn.ai/*", "https://dexscreener.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
